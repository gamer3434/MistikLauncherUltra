<Window x:Class="MistikLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mistik Launcher 6 Preview" Height="820" Width="1200"
        WindowStartupLocation="CenterScreen" Background="#142333"
        FontFamily="Segoe UI" UseLayoutRounding="True"
        MinHeight="600" MinWidth="1100">
    <Window.Resources>
        <!-- Nav button style -->
        <Style x:Key="NavBtn" TargetType="Button">
            <Setter Property="Background"                Value="Transparent"/>
            <Setter Property="Foreground"                Value="#D4DFE9"/>
            <Setter Property="BorderThickness"           Value="0"/>
            <Setter Property="Height"                    Value="42"/>
            <Setter Property="FontSize"                  Value="13"/>
            <Setter Property="FontFamily"                Value="Segoe UI"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding"                   Value="18,0"/>
            <Setter Property="Cursor"                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Margin="8,2">
                            <ContentPresenter VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FFFFFF"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#355269"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Accent button style -->
        <Style x:Key="AccentBtn" TargetType="Button">
            <Setter Property="Background"   Value="#00A3FF"/>
            <Setter Property="Foreground"   Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight"   Value="Bold"/>
            <Setter Property="FontFamily"   Value="Segoe UI"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" Margin="12,6"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FFFFFF"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#142333">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="86"/>
        </Grid.RowDefinitions>

        <!-- ═══ SIDEBAR ═══════════════════════════════════════════════════════ -->
        <Border Grid.Column="0" Grid.RowSpan="3" Background="#182D40">
            <DockPanel>
                <!-- Logo -->
                <Border DockPanel.Dock="Top" Margin="0,28,0,20">
                    <StackPanel>
                        <TextBlock x:Name="LogoText" Text="MISTIK"
                                   FontSize="30" FontWeight="Black"
                                   Foreground="#00A3FF" HorizontalAlignment="Center"
                                   FontFamily="Segoe UI Black"/>
                        <TextBlock Text="LAUNCHER"
                                   FontSize="10" FontWeight="Bold"
                                   Foreground="#BCCCDD" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                        <Border Background="#1a1a2e" CornerRadius="10" Margin="20,10,20,0"
                                Padding="8,4" Visibility="Collapsed">
                            <TextBlock x:Name="RelayStatusLbl" Text="Relay baglaniyor..."
                                       FontSize="10" Foreground="#A349A4"
                                       HorizontalAlignment="Center" FontFamily="Segoe UI"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Social buttons -->
                <StackPanel DockPanel.Dock="Bottom" Margin="12,0,12,14">
                    <Button x:Name="BtnDiscord" Content="Discord"
                            Style="{StaticResource AccentBtn}"
                            Background="#5865F2" Height="32" Margin="0,3"/>
                    <Button x:Name="BtnYoutube" Content="YouTube"
                            Style="{StaticResource AccentBtn}"
                            Background="#FF0000" Height="32" Margin="0,3"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Top" Margin="18,0,18,18">
                    <ComboBox x:Name="LanguageBox" MinHeight="36" Margin="0,0,0,12" AutomationProperties.Name="Türkçe / English">
                        <ComboBoxItem Content="Türkçe"/>
                        <ComboBoxItem Content="English"/>
                    </ComboBox>
                    <TextBlock x:Name="SearchLabel" Foreground="#BDCAD8" Margin="0,0,0,6"/>
                    <TextBox x:Name="NavSearch" MinHeight="36" Padding="8" Background="#203A50" Foreground="White" CaretBrush="White" AutomationProperties.Name="Search pages"/>
                </StackPanel>
                <!-- Nav -->
                <ScrollViewer VerticalScrollBarVisibility="Hidden">
                    <StackPanel x:Name="NavPanel" Margin="0,0,0,8"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ═══ CONTENT ═══════════════════════════════════════════════════════ -->
        <Frame x:Name="MainFrame" Grid.Column="1" Grid.Row="0"
               Background="Transparent" NavigationUIVisibility="Hidden"/>

        <!-- ═══ PROGRESS ══════════════════════════════════════════════════════ -->
        <ProgressBar x:Name="GlobalProgress" Grid.Column="1" Grid.Row="1"
                     Minimum="0" Maximum="100" Value="0"
                     Background="#142333" Foreground="#00A3FF" BorderThickness="0"/>

        <!-- ═══ CONTROL BAR ═══════════════════════════════════════════════════ -->
        <Border Grid.Column="1" Grid.Row="2" Background="#1C344A"
                BorderBrush="#355269" BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <!-- Left: avatar + info -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            HorizontalAlignment="Left">
                    <!-- Circular avatar -->
                    <Border Width="44" Height="44" CornerRadius="22"
                            Margin="0,0,14,0" ClipToBounds="True"
                            Background="#222">
                        <Image x:Name="AvatarImg" Width="44" Height="44"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                               Stretch="UniformToFill"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="UserNameLbl" FontSize="16" FontWeight="Bold"
                                   Foreground="White" FontFamily="Segoe UI"/>
                        <TextBlock x:Name="StatusLbl" FontSize="10" Foreground="#BCCCDD"
                                   FontFamily="Segoe UI"/>
                    </StackPanel>
                </StackPanel>

                <!-- Right: version + launch -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            HorizontalAlignment="Right">
                    <ComboBox x:Name="VerBox" Width="200" Height="38" Margin="0,0,14,0"
                              Background="#EAEAEA" Foreground="Black" FontWeight="Bold" BorderBrush="#D4DFE9" BorderThickness="1">
                        <ComboBox.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#142333" />
                            <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="White" />
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#00A3FF" />
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White" />
                        </ComboBox.Resources>
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Background" Value="#142333"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Padding" Value="10,6"/>
                                <Style.Triggers>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#FFFFFF"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#222222"/>
                                        <Setter Property="Foreground" Value="#00A3FF"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#00A3FF"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>
                    <Button x:Name="BtnLaunch" Content="OYUNA GIR"
                            Width="200" Height="54"
                            FontSize="18" FontWeight="Black"
                            FontFamily="Segoe UI Black"
                            Style="{StaticResource AccentBtn}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
