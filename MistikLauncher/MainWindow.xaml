<Window x:Class="MistikLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mistik Launcher 6 Preview" Height="820" Width="1200"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Theme0D1727}"
        FontFamily="Segoe UI" UseLayoutRounding="True"
        MinHeight="600" MinWidth="1100">
    <Window.Resources>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource Theme203853}"/>
            <Setter Property="Foreground" Value="#EFF5FF"/>
            <Setter Property="BorderBrush" Value="#36363C"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Focusable="False">
                                <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7"/></ControlTemplate></ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="10,0,30,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <TextBlock Text="⌄" Foreground="#ADBED6" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False"/>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                                <Border Background="{DynamicResource Theme203853}" BorderBrush="#36363C" BorderThickness="1" CornerRadius="7" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="280"><ItemsPresenter/></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Nav button style -->
        <Style x:Key="NavBtn" TargetType="Button">
            <Setter Property="Background"                Value="Transparent"/>
            <Setter Property="Foreground"                Value="#D4DFE9"/>
            <Setter Property="BorderThickness"           Value="0"/>
            <Setter Property="Height"                    Value="42"/>
            <Setter Property="FontSize"                  Value="13"/>
            <Setter Property="FontFamily"                Value="Segoe UI"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding"                   Value="18,0"/>
            <Setter Property="Cursor"                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Margin="8,2">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FFFFFF"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme365574}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Accent button style -->
        <Style x:Key="AccentBtn" TargetType="Button">
            <Setter Property="Background"   Value="{DynamicResource Theme00A3FF}"/>
            <Setter Property="Foreground"   Value="{DynamicResource ThemeActionText}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight"   Value="Bold"/>
            <Setter Property="FontFamily"   Value="Segoe UI"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" Margin="12,6"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FFFFFF"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel x:Name="WindowSurface">
        <Border x:Name="CaptionHost" DockPanel.Dock="Top" Height="42" Background="{DynamicResource Theme0D1727}" BorderBrush="{DynamicResource Theme365574}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel x:Name="CaptionButtons" Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center"/>
                <TextBlock Text="MISTIK LAUNCHER" Foreground="#A5A5B0" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12,0"/>
            </DockPanel>
        </Border>
    <Grid Background="{DynamicResource Theme0D1727}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="86"/>
        </Grid.RowDefinitions>

        <!-- ═══ CONTENT ═══════════════════════════════════════════════════════ -->
        <DockPanel Grid.Column="0" Grid.Row="0">
            <Grid DockPanel.Dock="Top" Margin="24,12,24,4">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="LogoText" Text="MISTIK" FontSize="22" FontWeight="Black" Foreground="{DynamicResource Theme00A3FF}" VerticalAlignment="Center"/>
                    <Button x:Name="BtnDiscord" Content="GitHub" Style="{StaticResource NavBtn}" Margin="18,0,0,0"/>
                    <Button x:Name="BtnYoutube" Content="Releases" Style="{StaticResource NavBtn}"/>
                    <TextBlock x:Name="RelayStatusLbl" Visibility="Collapsed"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox x:Name="LanguageBox" Width="110" Margin="0,0,14,0" AutomationProperties.Name="Türkçe / English"><ComboBoxItem Content="Türkçe"/><ComboBoxItem Content="English"/></ComboBox>
                    <Button x:Name="ProfileButton" Style="{StaticResource NavBtn}" Padding="8,0" MinHeight="48" ToolTip="Profile">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="36" Height="36" CornerRadius="8" Background="{DynamicResource Theme203853}" ClipToBounds="True" Margin="0,0,10,0"><Image x:Name="AvatarImg" RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="UniformToFill"/></Border>
                            <TextBlock x:Name="UserNameLbl" Foreground="#EFF5FF" FontSize="14" FontWeight="SemiBold" MaxWidth="180" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
            <Border x:Name="QuickBarHost" DockPanel.Dock="Top" Background="{DynamicResource Theme0D1727}" BorderBrush="{DynamicResource Theme365574}" BorderThickness="0,0,0,1" Padding="12,8">
                <WrapPanel x:Name="QuickBarPanel" HorizontalAlignment="Center"/>
            </Border>
        <Frame x:Name="MainFrame"
               Background="Transparent" NavigationUIVisibility="Hidden"/>
        </DockPanel>

        <!-- ═══ PROGRESS ══════════════════════════════════════════════════════ -->
        <ProgressBar x:Name="GlobalProgress" Grid.Column="0" Grid.Row="1"
                     Minimum="0" Maximum="100" Value="0"
                     Background="{DynamicResource Theme0D1727}" Foreground="{DynamicResource Theme00A3FF}" BorderThickness="0"/>

        <!-- ═══ CONTROL BAR ═══════════════════════════════════════════════════ -->
        <Border Grid.Column="0" Grid.Row="2" Background="{DynamicResource Theme152A43}"
                BorderBrush="{DynamicResource Theme365574}" BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <TextBlock x:Name="StatusLbl" Foreground="#A5A5B0" FontSize="12" VerticalAlignment="Center"/>

                <!-- Right: version + launch -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            HorizontalAlignment="Right">
                    <ComboBox x:Name="VerBox" Width="200" Height="38" Margin="0,0,14,0"
                              Background="{DynamicResource Theme203853}" Foreground="#EFF5FF" FontWeight="Bold" BorderBrush="#36363C" BorderThickness="1">
                        <ComboBox.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#0D1727" />
                            <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="White" />
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#00A3FF" />
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White" />
                        </ComboBox.Resources>
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Background" Value="{DynamicResource Theme0D1727}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Padding" Value="10,6"/>
                                <Style.Triggers>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#FFFFFF"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#222222"/>
                                        <Setter Property="Foreground" Value="{DynamicResource Theme00A3FF}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Theme00A3FF}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>
                    <Button x:Name="BtnLaunch" Content="OYUNA GIR"
                            Width="200" Height="54"
                            FontSize="18" FontWeight="Black"
                            FontFamily="Segoe UI Black"
                            Style="{StaticResource AccentBtn}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
    </DockPanel>
</Window>
