{
  "rules": {
    ".read": false,
    ".write": false,
    "activeSessions": {
      ".read": false,
      ".write": false
    },
    "launcherProfiles": {
      ".read": false,
      ".write": false
    },
    "launcherSupport": {
      "devices": {
        ".read": "auth != null && auth.token.email_verified == true && auth.token.email == 'ADMIN_EMAIL' && auth.token.firebase.sign_in_provider == 'google.com'",
        ".indexOn": ["lastSeen"],
        "$uid": {
          ".read": "auth != null && auth.uid == $uid && auth.token.firebase.sign_in_provider == 'anonymous'",
          ".write": "auth != null && auth.uid == $uid && auth.token.firebase.sign_in_provider == 'anonymous'",
          ".validate": "newData.hasChildren(['username', 'version', 'profile', 'lastSeen', 'modCount', 'truncated', 'allowRequests'])",
          "username": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 32" },
          "version": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}$/)" },
          "profile": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 160" },
          "lastSeen": { ".validate": "newData.isNumber() && newData.val() >= now - 300000 && newData.val() <= now + 300000" },
          "modCount": { ".validate": "newData.isNumber() && newData.val() % 1 == 0 && newData.val() >= 0 && newData.val() <= 100000" },
          "truncated": { ".validate": "newData.isBoolean()" },
          "allowRequests": { ".validate": "newData.isBoolean()" },
          "mods": {
            ".validate": "newData.hasChildren()",
            "$index": {
              ".validate": "$index.matches(/^(0|[1-9][0-9]?|[12][0-9]{2})$/) && newData.hasChildren(['name', 'enabled'])",
              "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 180 && !newData.val().contains('/') && !newData.val().contains('\\\\') && newData.val().matches(/^[^\u0000-\u001f\u007f-\u009f]+$/)" },
              "enabled": { ".validate": "newData.isBoolean()" },
              "$other": { ".validate": false }
            }
          },
          "$other": { ".validate": false }
        }
      },
      "requests": {
        ".read": "auth != null && auth.token.email_verified == true && auth.token.email == 'ADMIN_EMAIL' && auth.token.firebase.sign_in_provider == 'google.com'",
        "$uid": {
          ".read": "auth != null && auth.uid == $uid && auth.token.firebase.sign_in_provider == 'anonymous'",
          ".write": "auth != null && ((!newData.exists() && auth.uid == $uid && auth.token.firebase.sign_in_provider == 'anonymous') || (!data.exists() && newData.exists() && auth.token.email_verified == true && auth.token.email == 'ADMIN_EMAIL' && auth.token.firebase.sign_in_provider == 'google.com' && root.child('launcherSupport/devices').child($uid).exists() && root.child('launcherSupport/devices').child($uid).child('allowRequests').val() == true && root.child('launcherSupport/devices').child($uid).child('lastSeen').val() >= now - 300000 && root.child('launcherSupport/devices').child($uid).child('lastSeen').val() <= now + 300000))",
          ".validate": "newData.hasChildren(['id', 'projectId', 'projectName', 'profile', 'createdAt']) && newData.child('profile').val() == root.child('launcherSupport/devices').child($uid).child('profile').val()",
          "id": { ".validate": "newData.isString() && newData.val().matches(/^[0-9a-f]{32}$/)" },
          "projectId": { ".validate": "newData.isString() && newData.val().matches(/^[a-zA-Z0-9]{8}$/)" },
          "projectName": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 120" },
          "profile": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 160" },
          "createdAt": { ".validate": "newData.isNumber() && newData.val() >= now - 300000 && newData.val() <= now + 300000" },
          "$other": { ".validate": false }
        }
      },
      "$other": { ".validate": false }
    },
    "launcherMetrics": {
      ".read": "auth != null && auth.token.email_verified == true && auth.token.email == 'ADMIN_EMAIL' && auth.token.firebase.sign_in_provider == 'google.com'",
      "installations": {
        "$uid": {
          ".write": "auth != null && auth.uid == $uid && auth.token.firebase.sign_in_provider == 'anonymous'",
          ".validate": "newData.hasChildren(['firstSeen', 'lastSeen', 'version'])",
          "firstSeen": {
            ".validate": "newData.isNumber() && ((!data.exists() && newData.val() <= now + 60000 && newData.val() >= now - 300000) || (data.exists() && newData.val() == data.val()))"
          },
          "lastSeen": {
            ".validate": "newData.isNumber() && newData.val() <= now + 60000 && newData.val() >= now - 300000"
          },
          "version": {
            ".validate": "newData.isString() && newData.val().matches(/^[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}$/)"
          },
          "$other": {
            ".validate": false
          },
          ".read": "auth != null && auth.uid == $uid && auth.token.firebase.sign_in_provider == 'anonymous'"
        }
      },
      "sessions": {
        ".indexOn": [
          "lastSeen"
        ],
        "$uid": {
          ".write": "auth != null && auth.uid == $uid && auth.token.firebase.sign_in_provider == 'anonymous'",
          ".validate": "newData.hasChildren(['lastSeen', 'version'])",
          "lastSeen": {
            ".validate": "newData.isNumber() && newData.val() <= now + 60000 && newData.val() >= now - 300000"
          },
          "version": {
            ".validate": "newData.isString() && newData.val().matches(/^[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}$/)"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "errors": {
        "$uid": {
          ".write": "auth != null && auth.uid == $uid && auth.token.firebase.sign_in_provider == 'anonymous' && !newData.exists()",
          "$code": {
            ".write": "auth != null && auth.uid == $uid && auth.token.firebase.sign_in_provider == 'anonymous' && ($code == 'MLU-INTEGRITY' || $code == 'MLU-MEMORY' || $code == 'MLU-JAVA' || $code == 'MLU-MOD-DEPENDENCY' || $code == 'MLU-MOD-MIXIN' || $code == 'MLU-CLASSPATH' || $code == 'MLU-FILE' || $code == 'MLU-EXIT' || $code == 'MLU-LAUNCH' || $code == 'MLU-APP')",
            ".validate": "newData.hasChildren(['lastSeen', 'version', 'code', 'count'])",
            "lastSeen": {
              ".validate": "newData.isNumber() && newData.val() <= now + 60000 && newData.val() >= now - 300000"
            },
            "version": {
              ".validate": "newData.isString() && newData.val().matches(/^[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}$/)"
            },
            "code": {
              ".validate": "newData.isString() && newData.val() == $code"
            },
            "count": {
              ".validate": "newData.isNumber() && newData.val() % 1 == 0 && newData.val() >= 1 && newData.val() <= 1000000000 && ((!data.exists() && newData.val() == 1) || (data.exists() && newData.val() == data.val() + 1))"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    }
  }
}
