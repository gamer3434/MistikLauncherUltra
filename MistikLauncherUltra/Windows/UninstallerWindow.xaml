<Window x:Class="MistikLauncherUltra.Windows.UninstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mistik Client Kaldırma" Height="400" Width="550"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen">
    <Border Background="#1a0f0f" CornerRadius="12" BorderBrush="#FF4B4B" BorderThickness="1">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                <TextBlock Text="🗑️" FontSize="36" Margin="0,0,15,0" VerticalAlignment="Center" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Mistik Client Ultra" FontSize="26" FontWeight="Bold" Foreground="#FFFFFF" />
                    <TextBlock Text="Kaldırma Sihirbazı" FontSize="14" Foreground="#FF4B4B" />
                </StackPanel>
            </StackPanel>

            <!-- Content -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <TextBlock Text="Mistik Client ve tüm verilerini (Sunucular, ayarlar) silmek üzeresiniz." FontSize="14" Foreground="#E0E0E0" TextAlignment="Center" Margin="0,0,0,15" TextWrapping="Wrap" />
                
                <Border Background="#291616" CornerRadius="8" Padding="15" Margin="20,0">
                    <StackPanel>
                        <TextBlock Text="⚠ Uyarı: Bu işlem geri alınamaz!" Foreground="#FFB100" Margin="0,5" FontWeight="Bold" />
                        <TextBlock Text="- AppData dizinindeki '.mistik_ultra' silinecek" Foreground="#FF4B4B" Margin="0,5" />
                        <TextBlock Text="- Masaüstü ve Başlat menüsü kısayolları kaldırılacak" Foreground="#FF4B4B" Margin="0,5" />
                        <TextBlock Text="- Mistik Client sisteminizden tamamen temizlenecek" Foreground="#FF4B4B" Margin="0,5" />
                    </StackPanel>
                </Border>

                <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="20,30,20,0">
                    <TextBlock x:Name="StatusText" Text="Temizleniyor..." Foreground="#A0A0A0" FontSize="12" Margin="0,0,0,5" />
                    <ProgressBar x:Name="UninstallProgress" Height="8" Minimum="0" Maximum="100" Value="0" 
                                 Foreground="#FF4B4B" Background="#382020" BorderThickness="0" />
                </StackPanel>
            </StackPanel>

            <!-- Buttons -->
            <Grid Grid.Row="2" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="CancelBtn" Content="Vazgeç" Grid.Column="0" Margin="0,0,10,0" Height="40" Background="#242838" Foreground="White" BorderThickness="0" Cursor="Hand" Click="CancelBtn_Click" />
                <Button x:Name="UninstallBtn" Content="Kalıcı Olarak Sil" Grid.Column="1" Margin="10,0,0,0" Height="40" Background="#FF4B4B" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="UninstallBtn_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
