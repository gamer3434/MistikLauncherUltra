<Window x:Class="MistikLauncherUltra.Windows.InstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mistik Client Kurulum" Height="450" Width="600"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen">
    <Border Background="#0f111a" CornerRadius="12" BorderBrush="#00A3FF" BorderThickness="1">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                <TextBlock Text="🚀" FontSize="36" Margin="0,0,15,0" VerticalAlignment="Center" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Mistik Launcher" FontSize="26" FontWeight="Bold" Foreground="#FFFFFF" />
                    <TextBlock Text="Kurulum Sihirbazı" FontSize="14" Foreground="#00A3FF" />
                </StackPanel>
            </StackPanel>

            <!-- Content -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <TextBlock Text="Mistik Launcher bilgisayarınıza kurulmaya hazır." FontSize="16" Foreground="#E0E0E0" TextAlignment="Center" Margin="0,0,0,15" />
                
                <Border Background="#161a29" CornerRadius="8" Padding="15" Margin="20,0">
                    <StackPanel>
                        <TextBlock Text="✓ AppData dizinine tam optimizasyonlu kurulum" Foreground="#2EB82E" Margin="0,5" />
                        <TextBlock Text="✓ Masaüstü ve Başlat Menüsü kısayolları" Foreground="#2EB82E" Margin="0,5" />
                        <TextBlock Text="✓ Denetim Masası entegrasyonu (Program Ekle/Kaldır)" Foreground="#2EB82E" Margin="0,5" />
                        <TextBlock Text="✓ Riot Vanguard Uyumlu (Güvenli Yükleme)" Foreground="#00FFCC" Margin="0,5" FontWeight="Bold" />
                    </StackPanel>
                </Border>

                <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="20,30,20,0">
                    <TextBlock x:Name="StatusText" Text="Kuruluyor..." Foreground="#A0A0A0" FontSize="12" Margin="0,0,0,5" />
                    <ProgressBar x:Name="InstallProgress" Height="8" Minimum="0" Maximum="100" Value="0" 
                                 Foreground="#00A3FF" Background="#202538" BorderThickness="0" />
                </StackPanel>
            </StackPanel>

            <!-- Buttons -->
            <Grid Grid.Row="2" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="CancelBtn" Content="İptal Et" Grid.Column="0" Margin="0,0,10,0" Height="40" Background="#242838" Foreground="White" BorderThickness="0" Cursor="Hand" Click="CancelBtn_Click" />
                <Button x:Name="InstallBtn" Content="Kur ve Başlat" Grid.Column="1" Margin="10,0,0,0" Height="40" Background="#00A3FF" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="InstallBtn_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
